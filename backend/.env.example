# Vignan AI Campus EventOps - Backend Production Environment Example

# Application
PROJECT_NAME="Vignan AI Campus EventOps"
VERSION="1.0.0"
DEBUG=True
API_V1_STR="/api"

# Server
HOST="0.0.0.0"
PORT=8000

# Configurable CORS Origins (Comma separated string or JSON array)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,https://vignan-ai-eventops.onrender.com"

# MongoDB Atlas Database Configuration
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/"
MONGODB_DB_NAME="vignan_eventops"

# JWT Security
# Generate a unique value for your local .env; do not reuse this template.
JWT_SECRET="replace-with-a-unique-random-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: set all four to create demo users on first database initialization.
SEED_SUPERADMIN_PASSWORD=""
SEED_HOD_PASSWORD=""
SEED_ORGANIZER_PASSWORD=""
SEED_STUDENT_PASSWORD=""

# Anthropic Claude API Configuration
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
